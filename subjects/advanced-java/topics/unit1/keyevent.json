 "code": {
  "title": "Program: KeyEventExample",
  "lines": [
   "public class KeyEventExample extends JFrame implements KeyListener {",
   "    JTextField tf = new JTextField(15);",
   "    JLabel lbl = new JLabel(\"Press any key...\");",
   "",
   "    KeyEventExample() {",
   "        setLayout(new FlowLayout());",
   "        tf.addKeyListener(this);",
   "        add(tf);",
   "        add(lbl);",
   "        setSize(300, 120);",
   "        setVisible(true);",
   "    }",
   "",
   "    public void keyPressed(KeyEvent e) {",
   "        lbl.setText(\"Pressed Key: \" + e.getKeyChar() + \" | Code: \" + e.getKeyCode());",
   "    }",
   "    public void keyReleased(KeyEvent e) {}",
   "    public void keyTyped(KeyEvent e) {}",
   "",
   "    public static void main(String[] args) {",
   "        new KeyEventExample();",
   "    }",
   "}"
  ],
  "note": "(imports and EXIT_ON_CLOSE line skipped to keep it short)",
