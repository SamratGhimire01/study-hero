 "answer_html": "<h3>Definition</h3><p>Using JSP means writing pages with <b>JSP elements</b> (directives, declarations, scriptlets, expressions) and <b>implicit objects</b>.</p><table><tr><th>Element</th><th>Syntax</th><th>Use</th></tr><tr><td>Directive</td><td>&lt;%@ page / include / taglib %&gt;</td><td>Page settings</td></tr><tr><td>Declaration</td><td>&lt;%! … %&gt;</td><td>Declare variables/methods</td></tr><tr><td>Scriptlet</td><td>&lt;% … %&gt;</td><td>Java statements</td></tr><tr><td>Expression</td><td>&lt;%= … %&gt;</td><td>Print a value</td></tr><tr><td>Comment</td><td>&lt;%-- … --%&gt;</td><td>Hidden comment</td></tr><tr><td>Action</td><td>&lt;jsp:include&gt;, &lt;jsp:forward&gt;, &lt;jsp:useBean&gt;</td><td>Built-in actions</td></tr></table><h3>Implicit objects (9)</h3>request, response, out, session, application, config, pageContext, page, exception",
 "quiz": {
  "q": "Which tag prints a value into the page?",
  "options": [
   "<%! %>",
   "<% %>",
   "<%= %>"
  ],
  "answer": 2,
  "why": "Dogs Don’t Steal Eggs: E = Expression."
 }
