 "code": {
  "title": "Page: counter.jsp",
  "lines": [
   "<%@ page import=\"java.util.Date\" %>",
   "<%! int hits = 0; %>",
   "<html><body>",
   "<% hits++; %>",
   "<p>Page hits: <%= hits %></p>",
   "<p>Your session: <%= session.getId() %></p>",
   "</body></html>"
  ],
  "note": "(JSP page)",
